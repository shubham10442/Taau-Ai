rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function subjectBelongsToUser(subjectId) {
      return existsAfter(/databases/$(database)/documents/subjects/$(subjectId)) &&
        getAfter(/databases/$(database)/documents/subjects/$(subjectId)).data.userId == request.auth.uid;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'dailyStudyHours', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'dailyStudyHours', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        (data.dailyStudyHours is int || data.dailyStudyHours is float) &&
        data.dailyStudyHours >= 0.5 && data.dailyStudyHours <= 16 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll([
          'userId', 'title', 'examDate', 'dailyHours', 'syllabusOverview',
          'topics', 'totalTasks', 'completedTasks', 'averageQuizScore',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'title', 'examDate', 'dailyHours', 'syllabusOverview',
          'topics', 'totalTasks', 'completedTasks', 'averageQuizScore',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.examDate is string && data.examDate.size() >= 8 && data.examDate.size() <= 40 &&
        (data.dailyHours is int || data.dailyHours is float) &&
        data.dailyHours >= 0.5 && data.dailyHours <= 16 &&
        data.syllabusOverview is string && data.syllabusOverview.size() <= 1500 &&
        data.topics is list && data.topics.size() <= 40 &&
        (data.topics.size() == 0 || (data.topics[0] is string && data.topics[0].size() <= 160)) &&
        data.totalTasks is int && data.totalTasks >= 0 && data.totalTasks <= 500 &&
        data.completedTasks is int && data.completedTasks >= 0 && data.completedTasks <= 500 &&
        (data.averageQuizScore is int || data.averageQuizScore is float) &&
        data.averageQuizScore >= -1 && data.averageQuizScore <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudyTask(data) {
      return data.keys().hasAll([
          'userId', 'subjectId', 'topicTitle', 'description',
          'scheduledDate', 'durationMinutes', 'priority', 'status',
          'orderIndex', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'subjectId', 'topicTitle', 'description',
          'scheduledDate', 'durationMinutes', 'priority', 'status',
          'orderIndex', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.subjectId) &&
        data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 160 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 400 &&
        data.scheduledDate is string && data.scheduledDate.size() >= 8 && data.scheduledDate.size() <= 40 &&
        data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 480 &&
        data.priority in ['high', 'medium', 'normal'] &&
        data.status in ['pending', 'completed'] &&
        data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudySummary(data) {
      return data.keys().hasAll([
          'userId', 'subjectId', 'topicTitle', 'overview',
          'coreConcepts', 'formulaSheet', 'examPitfalls', 'memoryAnchor',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'subjectId', 'topicTitle', 'overview',
          'coreConcepts', 'formulaSheet', 'examPitfalls', 'memoryAnchor',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.subjectId) &&
        data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 160 &&
        data.overview is string && data.overview.size() >= 1 && data.overview.size() <= 2000 &&
        data.coreConcepts is list && data.coreConcepts.size() <= 15 &&
        (data.coreConcepts.size() == 0 || (data.coreConcepts[0] is string && data.coreConcepts[0].size() <= 500)) &&
        data.formulaSheet is list && data.formulaSheet.size() <= 15 &&
        (data.formulaSheet.size() == 0 || (
          data.formulaSheet[0] is map &&
          data.formulaSheet[0].keys().hasAll(['label', 'expression', 'note']) &&
          data.formulaSheet[0].keys().hasOnly(['label', 'expression', 'note']) &&
          data.formulaSheet[0].label is string && data.formulaSheet[0].label.size() <= 160 &&
          data.formulaSheet[0].expression is string && data.formulaSheet[0].expression.size() <= 300 &&
          data.formulaSheet[0].note is string && data.formulaSheet[0].note.size() <= 400
        )) &&
        data.examPitfalls is list && data.examPitfalls.size() <= 12 &&
        (data.examPitfalls.size() == 0 || (data.examPitfalls[0] is string && data.examPitfalls[0].size() <= 400)) &&
        data.memoryAnchor is string && data.memoryAnchor.size() <= 600 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuiz(data) {
      return data.keys().hasAll([
          'userId', 'subjectId', 'topicTitle', 'difficulty',
          'questions', 'userAnswers', 'scorePercent', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'subjectId', 'topicTitle', 'difficulty',
          'questions', 'userAnswers', 'scorePercent', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.subjectId) &&
        data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 160 &&
        data.difficulty in ['standard', 'intensive'] &&
        data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 15 &&
        data.questions[0] is map &&
        data.questions[0].keys().hasAll(['prompt', 'options', 'correctIndex', 'explanation']) &&
        data.questions[0].keys().hasOnly(['prompt', 'options', 'correctIndex', 'explanation']) &&
        data.questions[0].prompt is string && data.questions[0].prompt.size() <= 600 &&
        data.questions[0].options is list && data.questions[0].options.size() == 4 &&
        data.questions[0].correctIndex is int && data.questions[0].correctIndex >= 0 && data.questions[0].correctIndex <= 3 &&
        data.questions[0].explanation is string && data.questions[0].explanation.size() <= 800 &&
        data.userAnswers is list && data.userAnswers.size() <= 15 &&
        (data.userAnswers.size() == 0 || data.userAnswers[0] is int) &&
        data.scorePercent is int && data.scorePercent >= -1 && data.scorePercent <= 100 &&
        data.status in ['in_progress', 'completed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFlashcard(data) {
      return data.keys().hasAll([
          'userId', 'subjectId', 'topicTitle', 'front', 'back', 'hint',
          'boxLevel', 'masteryState', 'nextReviewAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'subjectId', 'topicTitle', 'front', 'back', 'hint',
          'boxLevel', 'masteryState', 'nextReviewAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.subjectId) &&
        data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 160 &&
        data.front is string && data.front.size() >= 1 && data.front.size() <= 500 &&
        data.back is string && data.back.size() >= 1 && data.back.size() <= 1200 &&
        data.hint is string && data.hint.size() <= 300 &&
        data.boxLevel is int && data.boxLevel >= 1 && data.boxLevel <= 5 &&
        data.masteryState in ['new', 'learning', 'mastered'] &&
        data.nextReviewAt is int && data.nextReviewAt >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'dailyStudyHours', 'updatedAt']);
      allow delete: if false;
    }

    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId) && isOwner(existing().userId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(subjectId) && isSignedIn() &&
        isValidSubject(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(subjectId) && isOwner(existing().userId) &&
        isValidSubject(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['completedTasks', 'totalTasks', 'averageQuizScore', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'examDate', 'dailyHours', 'updatedAt'])
        );
      allow delete: if isValidId(subjectId) && isOwner(existing().userId);
    }

    match /studyTasks/{taskId} {
      allow get: if isValidId(taskId) && isOwner(existing().userId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(taskId) && isSignedIn() &&
        isValidStudyTask(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        subjectBelongsToUser(incoming().subjectId);
      allow update: if isValidId(taskId) && isOwner(existing().userId) &&
        isValidStudyTask(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().subjectId == existing().subjectId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['scheduledDate', 'priority', 'durationMinutes', 'updatedAt'])
        );
      allow delete: if isValidId(taskId) && isOwner(existing().userId);
    }

    match /studySummaries/{summaryId} {
      allow get: if isValidId(summaryId) && isOwner(existing().userId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(summaryId) && isSignedIn() &&
        isValidStudySummary(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        subjectBelongsToUser(incoming().subjectId);
      allow update: if isValidId(summaryId) && isOwner(existing().userId) &&
        isValidStudySummary(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().subjectId == existing().subjectId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['overview', 'coreConcepts', 'formulaSheet', 'examPitfalls', 'memoryAnchor', 'updatedAt']);
      allow delete: if isValidId(summaryId) && isOwner(existing().userId);
    }

    match /quizzes/{quizId} {
      allow get: if isValidId(quizId) && isOwner(existing().userId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(quizId) && isSignedIn() &&
        isValidQuiz(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        subjectBelongsToUser(incoming().subjectId);
      allow update: if isValidId(quizId) && isOwner(existing().userId) &&
        isValidQuiz(incoming()) &&
        existing().status != 'completed' &&
        incoming().userId == existing().userId &&
        incoming().subjectId == existing().subjectId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['userAnswers', 'scorePercent', 'status', 'updatedAt']);
      allow delete: if isValidId(quizId) && isOwner(existing().userId);
    }

    match /flashcards/{cardId} {
      allow get: if isValidId(cardId) && isOwner(existing().userId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(cardId) && isSignedIn() &&
        isValidFlashcard(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        subjectBelongsToUser(incoming().subjectId);
      allow update: if isValidId(cardId) && isOwner(existing().userId) &&
        isValidFlashcard(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().subjectId == existing().subjectId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['boxLevel', 'masteryState', 'nextReviewAt', 'updatedAt']);
      allow delete: if isValidId(cardId) && isOwner(existing().userId);
    }
  }
}
