# GEMINI_API_KEY: Required for Gemini AI API calls on server.js.
# Set this in AI Studio Secrets or on your Node.js host (Render, Railway, Cloud Run).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional backend URL for static GitHub Pages builds.
# Leave empty for local development or same-origin hosting.
# Example: https://taau-ai-api.onrender.com
VITE_API_BASE_URL=""

# ALLOWED_ORIGINS: Optional comma-separated frontend origins allowed by CORS on server.js.
ALLOWED_ORIGINS=""
