{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student profile and study preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "dailyStudyHours": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "dailyStudyHours", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "An exam subject with syllabus overview, target exam date, and mastery metrics.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "examDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 40
        },
        "dailyHours": {
          "type": "number"
        },
        "syllabusOverview": {
          "type": "string",
          "maxLength": 1500
        },
        "topics": {
          "type": "array"
        },
        "totalTasks": {
          "type": "integer"
        },
        "completedTasks": {
          "type": "integer"
        },
        "averageQuizScore": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "examDate",
        "dailyHours",
        "syllabusOverview",
        "topics",
        "totalTasks",
        "completedTasks",
        "averageQuizScore",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "A personalized revision milestone scheduled for a subject before the exam.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "scheduledDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "integer"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "normal"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed"]
        },
        "orderIndex": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "subjectId",
        "topicTitle",
        "description",
        "scheduledDate",
        "durationMinutes",
        "priority",
        "status",
        "orderIndex",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudySummary": {
      "title": "StudySummary",
      "description": "AI-generated high-yield revision summary, formula sheet, and exam pitfalls.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "overview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "coreConcepts": {
          "type": "array"
        },
        "formulaSheet": {
          "type": "array"
        },
        "examPitfalls": {
          "type": "array"
        },
        "memoryAnchor": {
          "type": "string",
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "subjectId",
        "topicTitle",
        "overview",
        "coreConcepts",
        "formulaSheet",
        "examPitfalls",
        "memoryAnchor",
        "createdAt",
        "updatedAt"
      ]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Adaptive practice quiz with instant explanations and score tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "difficulty": {
          "type": "string",
          "enum": ["standard", "intensive"]
        },
        "questions": {
          "type": "array"
        },
        "userAnswers": {
          "type": "array"
        },
        "scorePercent": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "subjectId",
        "topicTitle",
        "difficulty",
        "questions",
        "userAnswers",
        "scorePercent",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "Spaced-repetition flashcard with Leitner box level and next review timestamp.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "front": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "back": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "hint": {
          "type": "string",
          "maxLength": 300
        },
        "boxLevel": {
          "type": "integer"
        },
        "masteryState": {
          "type": "string",
          "enum": ["new", "learning", "mastered"]
        },
        "nextReviewAt": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "subjectId",
        "topicTitle",
        "front",
        "back",
        "hint",
        "boxLevel",
        "masteryState",
        "nextReviewAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student profile documents scoped strictly to the owning UID."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Exam subjects created and owned by a student."
    },
    "/studyTasks/{taskId}": {
      "schema": { "$ref": "#/entities/StudyTask" },
      "description": "Personalized study plan milestones linked to a subject."
    },
    "/studySummaries/{summaryId}": {
      "schema": { "$ref": "#/entities/StudySummary" },
      "description": "AI-generated study summaries and formula sheets linked to a subject."
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Adaptive practice quizzes linked to a subject."
    },
    "/flashcards/{cardId}": {
      "schema": { "$ref": "#/entities/Flashcard" },
      "description": "Spaced-repetition flashcards linked to a subject."
    }
  }
}
